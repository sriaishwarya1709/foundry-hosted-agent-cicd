{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "stage": {
      "value": "${AZURE_STAGE=dev}"
    },
    "location": {
      "value": "${AZURE_LOCATION=swedencentral}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "principalType": {
      "value": "${AZURE_PRINCIPAL_TYPE=ServicePrincipal}"
    },
    "modelName": {
      "value": "${AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini}"
    },
    "modelCapacity": {
      "value": "${AZURE_AI_MODEL_CAPACITY=30}"
    },
    "webExists": {
      "value": "${SERVICE_WEB_RESOURCE_EXISTS=false}"
    }
  }
}
